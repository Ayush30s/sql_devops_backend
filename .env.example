# Copy to .env. `npm run setup` writes a working .env for local development automatically.

# Application database (Prisma). Any PostgreSQL 14+.
DATABASE_URL="postgresql://dsa:CHANGE_ME@localhost:54320/dsa"

# SQL practice sandbox. Use a SEPARATE PostgreSQL instance (or at least a separate database)
# from the application database. Roles are created by `node scripts/db.mjs sandbox-setup`.
SANDBOX_DATABASE_URL="postgresql://learner:CHANGE_ME@localhost:54321/sandbox"
SANDBOX_SUPERVISOR_URL="postgresql://supervisor:CHANGE_ME@localhost:54321/sandbox"
# Only needed when running `sandbox-setup` against your own server (never used by the app).
# SANDBOX_ADMIN_URL="postgresql://postgres:CHANGE_ME@localhost:54321/postgres"

# Where the API listens.
PORT=4000

# The frontend's public URL: the only origin allowed to make browser mutations, and the
# address cookies are issued for. https:// enables Secure cookies.
APP_URL="http://localhost:3000"

# Admin account created/updated by the seed script.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_TO_A_LONG_PASSWORD"

# ---- optional limits (defaults shown) ---------------------------------------------------------
# SQL_STATEMENT_TIMEOUT_MS=3000
# SQL_MAX_ROWS=500
# LAB_COMMAND_TIMEOUT_MS=5000
# LAB_MAX_COMMAND_LENGTH=2000
# LAB_MAX_OUTPUT_BYTES=65536
# LAB_WORKERS=2
# LOG_REQUESTS=true
